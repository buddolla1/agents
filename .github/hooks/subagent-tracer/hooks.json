{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": ".github/hooks/subagent-tracer/log-session-start.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": ".github/hooks/subagent-tracer/log-user-prompt.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/subagent-tracer/log-task.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": ".github/hooks/subagent-tracer/log-subagent-start.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": ".github/hooks/subagent-tracer/log-subagent-stop.sh",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
