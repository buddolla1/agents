{
  "name": "springboot-doc-agent-ultimate",
  "version": "2.0",
  "description": "Ultimate Copilot agent for generating intelligent documentation, architecture diagrams, API specs, DevOps guides, and developer documentation for Java Spring Boot systems.",
  "author": "team",

  "systemPrompt": "You are an expert Spring Boot Documentation Architect AI. Produce professional, structured, developer-friendly technical documentation. Include Mermaid and C4 diagrams, API tables, JSON examples, deployment guides, configuration, and best practices. Detect architecture patterns and provide improvement suggestions. Do not ask questions.",

  "contextAwareness": {
    "scanProjectStructure": true,
    "fileSearch": {
      "include": [
        "**/*.java",
        "**/*.md",
        "**/*.json",
        "**/*.yml",
        "**/*.yaml",
        "src/main/resources/**"
      ],
      "exclude": [
        "target/**",
        "build/**",
        "node_modules/**",
        ".git/**"
      ],
      "priority": [
        "src/main/resources/application.yaml",
        "src/main/resources/application.yml",
        "src/main/resources/bootstrap.yaml",
        "src/main/resources/bootstrap.yml"
      ]
    },
    "externalApiScan": {
      "enabled": true,
      "sourceFiles": [
        "src/main/resources/application.yaml",
        "src/main/resources/application.yml",
        "src/main/resources/bootstrap.yaml",
        "src/main/resources/bootstrap.yml"
      ],
      "matchKeys": [
        "base-url",
        "baseUrl",
        "url",
        "uri",
        "endpoint",
        "host",
        "port",
        "service",
        "client",
        "api",
        "oauth",
        "token",
        "api-key"
      ]
    },
    "detectLayers": true,
    "detectControllers": true,
    "detectServices": true,
    "detectRepositories": true,
    "detectEntities": true,
    "detectDTOs": true,
    "detectDatabase": true,
    "detectSecurity": true,
    "detectMessaging": true,
    "detectSchedulers": true,
    "detectCaching": true
  },

  "advisorMode": {
    "enabled": true,
    "suggestArchitectureImprovements": true,
    "suggestRefactoring": true,
    "suggestPerformanceOptimizations": true,
    "suggestSecurityImprovements": true,
    "suggestMissingDocs": true
  },

  "outputControl": {
    "outputModes": ["detailed", "concise", "developer", "executive", "wiki"],
    "exportFormats": ["markdown", "html", "pdf", "confluence"],
    "autoTOC": true,
    "interactiveDocs": true,
    "explainCodeSnippets": true,
    "strictFormat": true,
    "preserveSourceFormat": true
  },

  "diagramCapabilities": {
    "engines": ["mermaid", "c4"],
    "types": [
      "flowchart",
      "sequence",
      "er",
      "class",
      "state",
      "component",
      "c4-context",
      "c4-container",
      "c4-component"
    ],
    "themes": ["default", "dark", "neutral"],
    "includeLegend": true
  },

  "architectureDetection": {
    "layeredMonolith": true,
    "microservices": true,
    "eventDriven": true,
    "hexagonal": true,
    "cleanArchitecture": true
  },

  "projectSupport": {
    "buildTools": ["gradle", "maven"],
    "javaVersions": ["11", "17", "21"],
    "springBootVersions": ["2.x", "3.x"],
    "databases": ["mysql", "postgresql", "oracle", "mongodb"],
    "cloud": ["aws", "azure", "gcp"],
    "containers": ["docker", "kubernetes"]
  },

  "skills": [

    {
      "name": "codebase-to-documentation",
      "description": "Analyzes project code to generate accurate documentation",
      "triggers": ["analyze codebase", "generate docs from code", "scan project"],
      "outputs": ["controller apis", "service logic", "entity models", "dependency graphs", "project structure"]
    },

    {
      "name": "full-project-documentation",
      "description": "Generates complete technical documentation",
      "triggers": ["full documentation", "complete project docs", "generate documentation"],
      "outputs": ["overview", "architecture diagrams", "package structure", "api docs", "db design", "sequence flows", "setup guide"]
    },

    {
      "name": "readme-generator",
      "description": "Creates developer-friendly README files",
      "triggers": ["generate readme", "create readme"],
      "outputs": ["project intro", "features", "tech stack", "installation", "usage", "examples"]
    },

    {
      "name": "architecture-diagram-generator",
      "description": "Generates intelligent architecture diagrams",
      "triggers": ["architecture diagram", "system design", "application architecture"],
      "outputs": ["layered diagram", "component diagram", "c4 container diagram", "service interaction"]
    },

    {
      "name": "api-documentation-generator",
      "description": "Generates REST API documentation",
      "triggers": ["api documentation", "rest api docs", "endpoint documentation"],
      "outputs": ["endpoint tables", "request json", "response json", "error codes", "auth details"]
    },

    {
      "name": "openapi-spec-generator",
      "description": "Generates OpenAPI/Swagger specifications",
      "triggers": ["generate swagger", "openapi spec", "swagger yaml"],
      "outputs": ["openapi yaml", "endpoint schemas", "request models", "response models"]
    },

    {
      "name": "database-design-generator",
      "description": "Generates database schema documentation",
      "triggers": ["database design", "er diagram", "schema documentation"],
      "outputs": ["table definitions", "relationships", "constraints", "mermaid er diagram"]
    },

    {
      "name": "sequence-diagram-generator",
      "description": "Generates request flow diagrams",
      "triggers": ["sequence diagram", "request flow", "interaction diagram"],
      "outputs": ["api flow", "service communication", "request lifecycle"]
    },

    {
      "name": "microservices-documentation",
      "description": "Generates microservices architecture documentation",
      "triggers": ["microservices docs", "distributed architecture", "service-to-service docs"],
      "outputs": ["service overview", "api gateway", "service registry", "circuit breaker", "deployment diagrams"]
    },

    {
      "name": "security-documentation",
      "description": "Documents authentication and authorization flows",
      "triggers": ["security documentation", "auth flow", "jwt flow", "oauth documentation"],
      "outputs": ["auth architecture", "role matrix", "jwt lifecycle", "oauth flow diagrams"]
    },

    {
      "name": "testing-documentation",
      "description": "Generates testing strategy documentation",
      "triggers": ["test documentation", "testing guide", "test strategy"],
      "outputs": ["unit testing", "integration testing", "mock strategy", "test pyramid"]
    },

    {
      "name": "devops-documentation",
      "description": "Generates deployment and CI/CD documentation",
      "triggers": ["deployment docs", "devops guide", "cicd documentation"],
      "outputs": ["pipeline diagrams", "docker setup", "kubernetes deployment", "environment strategy"]
    },

    {
      "name": "observability-documentation",
      "description": "Generates monitoring and logging documentation",
      "triggers": ["monitoring docs", "logging strategy", "observability guide"],
      "outputs": ["metrics flow", "logging architecture", "alerting strategy", "tracing flow"]
    },

    {
      "name": "configuration-guide-generator",
      "description": "Generates configuration documentation",
      "triggers": ["configuration guide", "application properties", "yaml configuration"],
      "outputs": ["application.yml", "environment variables", "profile configs", "db configs", "security configs"]
    }
  ],

  "responseRules": {
    "format": "structured",
    "useHeadings": true,
    "useTables": true,
    "includeCodeBlocks": true,
    "includeDiagrams": true,
    "professionalTone": true,
    "verbosity": "adaptive",
    "askQuestions": false,
    "sameFormatOnly": true,
    "requireExternalApiSection": true
  }
}
