{
  "name": "React ADA Fix Recommender",
  "id": "react-ada-fixer",
  "description": "Consumes ADA accessibility analysis reports and suggests or applies fixes to React code based on WCAG guidelines.",
  "version": "2.0.0",
  "type": "processor",
  "input": {
    "type": "object",
    "properties": {
      "fileContent": {
        "type": "string",
        "description": "Original React JSX/TSX code"
      },
      "adaReport": {
        "type": "object",
        "description": "Accessibility report generated by analyzer agent",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "severity": { "type": "string" },
                "line": { "type": "number" },
                "description": { "type": "string" },
                "wcagReference": { "type": "string" },
                "suggestion": { "type": "string" }
              }
            }
          }
        }
      },
      "fixMode": {
        "type": "string",
        "enum": ["suggest_only", "auto_fix"],
        "default": "suggest_only"
      }
    },
    "required": ["fileContent", "adaReport"]
  },
  "output": {
    "type": "object",
    "properties": {
      "fixSummary": {
        "type": "string"
      },
      "fixes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "issueType": { "type": "string" },
            "line": { "type": "number" },
            "originalCode": { "type": "string" },
            "fixedCode": { "type": "string" },
            "explanation": { "type": "string" }
          }
        }
      },
      "updatedCode": {
        "type": "string"
      },
      "diff": {
        "type": "string"
      }
    }
  },
  "workflow": [
    {
      "step": "Parse ADA report",
      "action": "Extract issues and map to fix strategies"
    },
    {
      "step": "Locate code segments",
      "action": "Identify affected lines/components in JSX"
    },
    {
      "step": "Apply fix rules",
      "action": "Transform code using WCAG-compliant patterns"
    },
    {
      "step": "Generate updated code",
      "action": "Return modified JSX if auto_fix is enabled"
    },
    {
      "step": "Generate diff",
      "action": "Show before vs after changes"
    },
    {
      "step": "Explain fixes",
      "action": "Provide reasoning for each fix"
    }
  ],
  "skills": [
    "ada-report-parser",
    "jsx-locator",
    "wcag-fix-engine",
    "aria-enhancer",
    "semantic-html-transformer",
    "keyboard-accessibility-fixer",
    "form-label-fixer",
    "image-alt-fixer",
    "diff-generator"
  ],
  "fixStrategies": {
    "image-alt-missing": {
      "fix": "Add alt attribute",
      "template": "<img src=\"{src}\" alt=\"{description}\" />"
    },
    "button-name-missing": {
      "fix": "Add accessible label",
      "template": "<button aria-label=\"{label}\">{content}</button>"
    },
    "clickable-div": {
      "fix": "Replace div with button",
      "template": "<button onClick={handler}>{content}</button>"
    },
    "input-label-missing": {
      "fix": "Add label element",
      "template": "<label>{label}<input {...props} /></label>"
    },
    "aria-role-invalid": {
      "fix": "Remove or correct ARIA role",
      "template": "Use semantic HTML instead"
    }
  },
  "rules": [
    "Prefer semantic HTML over ARIA",
    "Do not break existing functionality",
    "Ensure keyboard accessibility",
    "Preserve developer intent",
    "Add minimal necessary attributes only",
    "Avoid overuse of aria-* attributes"
  ],
  "interactions": [
    {
      "question": "Do you want automatic fixes applied?",
      "options": ["yes", "no"]
    },
    {
      "question": "Should fixes prioritize minimal change or strict WCAG compliance?",
      "options": ["minimal", "strict"]
    }
  ],
  "examples": [
    {
      "input": {
        "fileContent": "<div onClick={submit}>Submit</div>",
        "adaReport": {
          "issues": [
            {
              "type": "clickable-div",
              "line": 1,
              "description": "Not keyboard accessible"
            }
          ]
        }
      },
      "output": {
        "fixes": [
          {
            "issueType": "clickable-div",
            "fixedCode": "<button onClick={submit}>Submit</button>"
          }
        ]
      }
    }
  ]
}